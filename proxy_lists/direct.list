# ДОМЕНЫ И КОРНЕВЫЕ ЗОНЫ
# ----------------------------------------------------

# --- КОРНЕВЫЕ РОССИЙСКИЕ ЗОНЫ (Решение проблемы Geo-блокировки) ---
# Весь трафик в эти зоны пойдет напрямую, минуя VPN
DOMAIN-SUFFIX,ru
DOMAIN-SUFFIX,su
DOMAIN-SUFFIX,xn--p1ai
DOMAIN-SUFFIX,by              # Беларусь (опционально, но связано с РФ)
DOMAIN-SUFFIX,kz              # Казахстан (опционально)

# --- РОССИЙСКИЕ СЕРВИСЫ В МЕЖДУНАРОДНЫХ ЗОНАХ ---
# Если сервис использует .com/.net/.me, он не попадет под зоны выше, 
# поэтому их нужно указать явно
DOMAIN-SUFFIX,vk.com
DOMAIN-SUFFIX,mycdn.me
DOMAIN-SUFFIX,yandex.net
DOMAIN-SUFFIX,yastatic.net
DOMAIN-SUFFIX,tamtam.chat
DOMAIN-KEYWORD,yandex
DOMAIN-KEYWORD,vkontakte
